{
  "version": 1,
  "author": "Sumant Jadiyappagoudar — Wearable ECG Belt",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp",      "top": 120, "left": 400, "attrs": {} },
    { "type": "board-ssd1306",         "id": "oled1",    "top":  40, "left": 700, "attrs": { "i2cAddress": "0x3c" } },

    {
      "type": "chip-ecg-afe",
      "id":   "afe1",
      "top":  140,
      "left": 140,
      "attrs": {
        "heartRate":      "72",
        "wanderAmp":      "35",
        "noiseAmp":       "2",
        "plAmp":          "15",
        "inaGain":        "450",
        "contactQuality": "98",
        "cmrrDb":         "100"
      }
    },

    { "type": "wokwi-potentiometer", "id": "pot_ra",     "top":  60, "left": -140, "attrs": { "label": "RA Electrode" } },
    { "type": "wokwi-potentiometer", "id": "pot_la",     "top": 150, "left": -140, "attrs": { "label": "LA Electrode" } },
    { "type": "wokwi-potentiometer", "id": "pot_rl",     "top": 240, "left": -140, "attrs": { "label": "RL Reference"  } },
    { "type": "wokwi-potentiometer", "id": "pot_ll",     "top": 330, "left": -140, "attrs": { "label": "LL Electrode"  } },
    { "type": "wokwi-potentiometer", "id": "pot_v1",     "top": 420, "left": -140, "attrs": { "label": "V1 Precordial" } },
    { "type": "wokwi-potentiometer", "id": "pot_v5",     "top": 510, "left": -140, "attrs": { "label": "V5 Precordial" } },
    { "type": "wokwi-potentiometer", "id": "pot_hr",     "top": 600, "left": -140, "attrs": { "label": "Heart Rate"    } },

    { "type": "wokwi-led",        "id": "led_beat",   "top":  40, "left": 380, "attrs": { "color": "green", "label": "Beat" } },
    { "type": "wokwi-resistor",   "id": "r_led",      "top":  42, "left": 336, "rotate": 90, "attrs": { "value": "330" } },
    { "type": "wokwi-pushbutton", "id": "btn_leadoff","top": 540, "left": 620, "attrs": { "color": "red", "label": "Lead-off", "bounce": "0" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3",   "oled1:VCC", "red",    ["h10","v0"] ],
    [ "esp:GND.1", "oled1:GND", "black",  ["h10","v0"] ],
    [ "esp:D22",   "oled1:SCL", "blue",   ["h10","v0"] ],
    [ "esp:D21",   "oled1:SDA", "purple", ["h10","v0"] ],

    [ "afe1:VCC",  "esp:3V3",   "red",    ["h10","v0"] ],
    [ "afe1:GND",  "esp:GND.1", "black",  ["h10","v0"] ],
    [ "afe1:OUT",  "esp:D34",   "yellow", ["h10","v0"] ],
    [ "afe1:BEAT", "esp:D26",   "lime",   ["h10","v0"] ],

    [ "pot_ra:VCC", "esp:3V3",   "red",   ["h10","v0"] ],
    [ "pot_ra:GND", "esp:GND.1", "black", ["h10","v0"] ],
    [ "pot_ra:SIG", "afe1:RA",   "cyan",  ["h10","v0"] ],

    [ "pot_la:VCC", "esp:3V3",   "red",   ["h10","v0"] ],
    [ "pot_la:GND", "esp:GND.1", "black", ["h10","v0"] ],
    [ "pot_la:SIG", "afe1:LA",   "cyan",  ["h10","v0"] ],

    [ "pot_rl:VCC", "esp:3V3",   "red",   ["h10","v0"] ],
    [ "pot_rl:GND", "esp:GND.1", "black", ["h10","v0"] ],
    [ "pot_rl:SIG", "afe1:RL",   "gray",  ["h10","v0"] ],

    [ "pot_ll:VCC", "esp:3V3",   "red",    ["h10","v0"] ],
    [ "pot_ll:GND", "esp:GND.1", "black",  ["h10","v0"] ],
    [ "pot_ll:SIG", "afe1:LL",   "cyan",   ["h10","v0"] ],

    [ "pot_v1:VCC", "esp:3V3",   "red",    ["h10","v0"] ],
    [ "pot_v1:GND", "esp:GND.1", "black",  ["h10","v0"] ],
    [ "pot_v1:SIG", "afe1:V1",   "teal",   ["h10","v0"] ],

    [ "pot_v5:VCC", "esp:3V3",   "red",    ["h10","v0"] ],
    [ "pot_v5:GND", "esp:GND.1", "black",  ["h10","v0"] ],
    [ "pot_v5:SIG", "afe1:V5",   "teal",   ["h10","v0"] ],

    [ "pot_hr:VCC", "esp:3V3",   "red",    ["h10","v0"] ],
    [ "pot_hr:GND", "esp:GND.1", "black",  ["h10","v0"] ],
    [ "pot_hr:SIG", "afe1:HR_IN","orange", ["h10","v0"] ],

    [ "r_led:1",         "esp:D2",         "green", ["h10","v0"] ],
    [ "r_led:2",         "led_beat:A",     "green", ["h10","v0"] ],
    [ "led_beat:C",      "esp:GND.1",      "black", ["h10","v0"] ],

    [ "btn_leadoff:1.l", "esp:D15",        "white", ["h10","v0"] ],
    [ "btn_leadoff:2.l", "esp:GND.1",      "black", ["h10","v0"] ],
    [ "btn_leadoff:1.l", "afe1:LEADOFF",   "white", ["h10","v0"] ]
  ],
  "dependencies": {}
}