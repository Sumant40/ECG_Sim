{
  "name": "ECG Electrode + AFE",
  "author": "Sumant Jadiyappagoudar",
  "pins": [
    "VCC",
    "GND",
    "HR_IN",
    "WANDER_IN",
    "LEADOFF_IN",
    "OUT",
    "",
    ""
  ],
  "controls": [
    {
      "id": "heartRate",
      "label": "Heart Rate (BPM)",
      "type": "range",
      "min": 40,
      "max": 180,
      "step": 1
    },
    {
      "id": "wanderAmp",
      "label": "Baseline Wander (0-200 uV)",
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 1
    },
    {
      "id": "noiseAmp",
      "label": "EMG Noise (0-50 uV)",
      "type": "range",
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "id": "plAmp",
      "label": "50Hz Power-line (0-100 uV)",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "inaGain",
      "label": "INA Gain (1-200)",
      "type": "range",
      "min": 1,
      "max": 200,
      "step": 1
    }
  ]
}